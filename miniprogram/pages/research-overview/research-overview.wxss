page { background: #f6f7f9; }
.page { min-height: 100vh; padding: 40rpx 32rpx 72rpx; box-sizing: border-box; color: #1f2329; }
.header { margin-bottom: 28rpx; }
.header-title { font-size: 42rpx; line-height: 1.4; font-weight: 650; }
.header-desc { margin-top: 12rpx; color: #646a73; font-size: 26rpx; line-height: 1.6; }
.state-card, .subject-card { padding: 28rpx; background: #fff; border-radius: 22rpx; box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, .05); }
.state-card { color: #646a73; text-align: center; }
.error-card { color: #c23b32; }
.retry-button { margin-top: 22rpx; width: 240rpx; font-size: 26rpx; color: #fff; background: #2878d0; }
.summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; margin-bottom: 28rpx; }
.summary-card { padding: 20rpx 8rpx; text-align: center; background: #fff; border-radius: 18rpx; }
.summary-value { font-size: 36rpx; font-weight: 650; color: #2878d0; }
.summary-label { margin-top: 4rpx; font-size: 22rpx; color: #8f959e; }
.filters { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.filter { min-width: 112rpx; padding: 14rpx 22rpx; text-align: center; border-radius: 999rpx; color: #646a73; background: #e9ebee; font-size: 26rpx; }
.filter-active { color: #fff; background: #2878d0; }
.subject-card { margin-bottom: 22rpx; }
.subject-top, .meta-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.subject-name { font-size: 32rpx; font-weight: 600; }
.subject-id { margin-top: 6rpx; color: #8f959e; font-size: 22rpx; word-break: break-all; }
.type-tag { flex: 0 0 auto; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; }
.type-teacher { color: #2567a9; background: #eaf3ff; }
.type-student { color: #247a55; background: #e9f7f0; }
.meta-row { margin-top: 20rpx; color: #646a73; font-size: 26rpx; }
.progress-value { color: #2878d0; font-weight: 600; }
.progress-track { height: 12rpx; margin-top: 14rpx; overflow: hidden; border-radius: 999rpx; background: #e9edf2; }
.progress-fill { height: 100%; border-radius: inherit; background: #2878d0; }
.coverage-note, .updated-text { margin-top: 14rpx; color: #8f959e; font-size: 23rpx; line-height: 1.6; }
.guidance-box { margin-top: 22rpx; padding: 20rpx; border-radius: 16rpx; background: #f5f8fc; }
.guidance-title { font-size: 26rpx; font-weight: 600; }
.guidance-text { margin-top: 8rpx; color: #646a73; font-size: 24rpx; line-height: 1.6; }
.page-note { margin-top: 30rpx; color: #8f959e; font-size: 23rpx; line-height: 1.7; text-align: center; }
