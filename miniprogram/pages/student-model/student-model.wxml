<view class="page">
  <view wx:if="{{loading}}" class="state-card">
    <view class="state-title">正在读取学生模型</view>
    <view class="state-desc">请稍候</view>
  </view>

  <view wx:elif="{{!hasModel}}" class="state-card">
    <view class="state-title">暂无可查看的学生模型</view>
    <view class="state-desc">{{errorMessage}}</view>
    <view class="refresh-button" bindtap="refreshModel">重新读取</view>
  </view>

  <block wx:else>
    <view class="model-header">
      <view class="model-header-title">{{pageTitle}}</view>
      <view class="model-header-desc">{{pageDescription}}</view>

      <view class="model-meta">
        <text>版本 {{modelVersion}}</text>
        <text class="meta-dot">·</text>
        <text>首次模型</text>
        <view class="model-status-tag model-status-{{modelStatus}}">
          {{modelStatusName}}
        </view>
      </view>

      <view wx:if="{{modelUpdatedAt}}" class="model-updated">
        更新时间 {{modelUpdatedAt}}
      </view>
    </view>

    <view class="overview-card">
      <view class="overview-heading">当前模型概览</view>
      <view class="overview-text">{{overviewSummary}}</view>
    </view>

    <view class="progress-card">
      <view class="progress-card-top">
        <view>
          <view class="progress-heading">模型构建进展</view>
          <view class="progress-subtitle">各维度证据覆盖与持续积累情况</view>
        </view>
        <view class="progress-total">
          {{constructionProgressLoading ? '—' : constructionProgressPercent}}%
        </view>
      </view>

      <canvas
        wx:if="{{constructionProgressDimensions.length >= 3}}"
        type="2d"
        id="studentProgressRadar"
        class="radar-canvas"
      ></canvas>

      <view
        wx:for="{{constructionProgressDimensions}}"
        wx:key="dimension_id"
        class="progress-row"
      >
        <view class="progress-row-label">{{item.dimension_id}} {{item.display_name}}</view>
        <view class="progress-row-track">
          <view class="progress-row-fill" style="width: {{item.progress_percent}}%;"></view>
        </view>
        <view class="progress-row-value">{{item.progress_percent}}%</view>
      </view>

      <view class="progress-note">
        {{constructionProgressLoading ? '正在读取构建进度…' : constructionProgressNote}}
      </view>
    </view>

    <view class="details-heading">具体模型信息</view>

    <view
      wx:for="{{dimensions}}"
      wx:key="dimension_id"
      class="dimension-section"
    >
      <view class="dimension-title-row">
        <view class="dimension-code">{{item.dimension_id}}</view>
        <view class="dimension-name">{{item.dimension_name}}</view>
      </view>

      <view
        wx:for="{{item.variables}}"
        wx:for-item="variable"
        wx:key="variable_id"
        class="variable-card"
      >
        <view class="variable-top">
          <view class="variable-title-wrap">
            <view class="variable-code">{{variable.variable_id}}</view>
            <view class="variable-name">{{variable.variable_name}}</view>
          </view>

          <view class="confidence-tag confidence-{{variable.status_key}}">
            {{variable.current_status}}
          </view>
        </view>

        <view class="content-block">
          <view class="content-label">当前主体刻画</view>
          <view class="current-state">{{variable.current_description}}</view>
        </view>

        <view
          wx:if="{{variable.uncertainty && variable.uncertainty.length > 0}}"
          class="content-block uncertainty-block"
        >
          <view class="content-label">还不确定的地方</view>
          <view
            wx:for="{{variable.uncertainty}}"
            wx:key="*this"
            class="simple-list-item"
          >
            {{item}}
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{cautions.length > 0}}" class="section-card caution-section">
      <view class="section-heading">模型说明</view>
      <view wx:for="{{cautions}}" wx:key="*this" class="caution-item">
        {{index + 1}}. {{item}}
      </view>
    </view>

    <view class="bottom-refresh" bindtap="refreshModel">刷新当前模型</view>
  </block>
</view>
