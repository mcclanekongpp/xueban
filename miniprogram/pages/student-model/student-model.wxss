page { background: #f5f7fa; }
.page { min-height: 100vh; padding: 34rpx 28rpx 60rpx; box-sizing: border-box; }
.state-card, .header-card, .variable-card, .caution-card { background: #fff; border-radius: 22rpx; padding: 30rpx; }
.state-card { margin-top: 120rpx; text-align: center; color: #6e747d; }
.header-title { font-size: 36rpx; font-weight: 600; color: #232930; }
.header-meta { margin-top: 14rpx; font-size: 24rpx; color: #49705a; }
.header-desc { margin-top: 16rpx; font-size: 25rpx; line-height: 1.65; color: #737b76; }
.dimension { margin-top: 34rpx; }
.dimension-title { margin: 0 8rpx 18rpx; font-size: 31rpx; font-weight: 600; color: #2a4e3a; }
.variable-card { margin-top: 18rpx; }
.variable-top { display: flex; justify-content: space-between; align-items: flex-start; }
.variable-name { flex: 1; font-size: 28rpx; font-weight: 600; color: #2a3036; }
.status-tag { margin-left: 16rpx; padding: 7rpx 14rpx; border-radius: 999rpx; background: #edf6f0; color: #387250; font-size: 22rpx; }
.label { margin-top: 24rpx; font-size: 23rpx; color: #838a92; }
.description { margin-top: 10rpx; font-size: 27rpx; line-height: 1.7; color: #3c4249; }
.meta { margin-top: 20rpx; font-size: 23rpx; color: #747c85; }
.uncertainty { margin-top: 20rpx; padding-top: 2rpx; border-top: 1rpx solid #eef0f2; }
.uncertainty-item { margin-top: 9rpx; font-size: 24rpx; line-height: 1.6; color: #777f88; }
.caution-card { margin-top: 30rpx; background: #fff9ed; }
.caution-item { margin-top: 10rpx; font-size: 24rpx; line-height: 1.65; color: #73664d; }
