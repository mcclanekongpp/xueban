page {
  min-height: 100%;
  background: #f5f7fa;
}

.page {
  min-height: 100vh;
  padding: 44rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.loading {
  padding-top: 160rpx;
  font-size: 28rpx;
  color: #737983;
  text-align: center;
}

.status-card {
  padding: 46rpx 34rpx;
  background: #edf7f1;
  border-radius: 26rpx;
  text-align: center;
}

.status-icon {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: #2f9b63;
  color: #ffffff;
  font-size: 42rpx;
  line-height: 72rpx;
}

.status-title {
  font-size: 36rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #234a35;
}

.status-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #547361;
}

.info-card {
  margin-top: 26rpx;
  padding: 4rpx 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.info-row-last {
  border-bottom: 0;
}

.info-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #777d86;
}

.info-value {
  margin-left: 28rpx;
  font-size: 27rpx;
  color: #24282f;
  text-align: right;
  word-break: break-all;
}

.code {
  font-family: monospace;
  font-size: 24rpx;
}

.next-button {
  margin-top: 34rpx;
  border-radius: 18rpx;
  font-size: 29rpx;
}

.progress-card {
  margin-top: 26rpx;
  padding: 28rpx 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  font-size: 28rpx;
  color: #31363d;
}

.progress-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f7955;
}

.completed-card {
  margin-top: 34rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  background: #edf7f1;
  color: #276744;
  font-size: 29rpx;
  text-align: center;
}

.action-card {
  margin-top: 26rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #29352e;
}

.action-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #737d76;
}

.secondary-button {
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: #edf7f1;
  color: #28714a;
  font-size: 28rpx;
}

.secondary-button::after {
  border: 0;
}

.pending-text {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #929993;
}

.note {
  margin-top: 28rpx;
  padding: 0 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a9099;
  text-align: center;
}
