page {
  min-height: 100%;
  background: #f6f7f9;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 56rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  max-width: 900rpx;
  margin: 0 auto;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #1f2329;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #7f858d;
}

.state-card,
.prompt-card,
.answer-card {
  padding: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.state-card {
  margin-top: 160rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #25282e;
}

.state-desc {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #7d838d;
}

.prompt-card {
  border-top-left-radius: 8rpx;
}

.prompt {
  font-size: 29rpx;
  line-height: 1.8;
  color: #3f444b;
}

.help {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7f858d;
}

.answer-card {
  max-width: 86%;
  margin-top: 24rpx;
  margin-left: auto;
  padding: 24rpx 26rpx;
  border-top-right-radius: 8rpx;
  background: #eaf3ff;
}

.answer-label {
  font-size: 22rpx;
  line-height: 1.4;
  color: #6f7f95;
}

.answer-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #34383e;
}

.voice-area {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-height: 390rpx;
  padding-top: 36rpx;
}

.voice-button {
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(31, 35, 41, 0.10);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.voice-button.recording {
  background: #eaf3ff;
  transform: scale(.97);
  box-shadow: 0 12rpx 38rpx rgba(47, 125, 225, 0.18);
}

.voice-icon {
  font-size: 62rpx;
  line-height: 1;
}

.voice-text {
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 500;
  color: #25292f;
}

.voice-tip {
  margin-top: 24rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #969ba3;
  text-align: center;
}

.submit-button,
.retry-button {
  width: 100%;
  min-height: 92rpx;
  margin-top: 30rpx;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 500;
}

.submit-button {
  background: #e3e6ea;
  color: #9ba0a7;
}

.submit-button.ready {
  background: #2475d0;
  color: #ffffff;
}

.retry-button {
  background: #fff4df;
  color: #84652c;
}

.submit-button::after,
.retry-button::after {
  border: 0;
}
