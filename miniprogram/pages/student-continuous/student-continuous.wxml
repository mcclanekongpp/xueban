<view class="page">
  <view wx:if="{{loading}}" class="state-card">
    <view class="state-title">正在准备</view>
    <view class="state-desc">请稍候</view>
  </view>

  <block wx:else>
    <view class="header">
      <view class="title">再说一说</view>
      <view class="subtitle">说真实发生的事情就可以，没有标准答案</view>
    </view>

    <view class="prompt-card">
      <view class="prompt">
        {{guidancePrompt || '最近在学习、观察、做事情或者和同学一起活动时，有没有什么事情想和我们说一说？'}}
      </view>
      <view class="help">
        {{guidancePrompt ? '可以说发生了什么、你当时怎么想、后来怎么做，也可以说别的真实经历。' : '遇到困难、新发现、改变想法，或者和别人一起完成一件事情，都可以说。'}}
      </view>
    </view>

    <view wx:if="{{lastTranscript}}" class="answer-card">
      <view class="answer-label">刚才说的是</view>
      <view class="answer-text">{{lastTranscript}}</view>
    </view>

    <view class="voice-area">
      <view
        class="voice-button {{isRecording ? 'recording' : ''}}"
        bindtouchstart="startRecording"
        bindtouchend="stopRecording"
        bindtouchcancel="stopRecording"
      >
        <view class="voice-icon">🎙️</view>
        <view class="voice-text">{{isRecording ? '正在听你说' : '按住说话'}}</view>
      </view>
      <view class="voice-tip">
        {{isRecording ? '松开结束录音' : isSubmitting ? '正在分析并提交' : isUploading ? '正在保存录音' : isTranscribing ? '正在识别语音' : '请尽量在安静环境中使用'}}
      </view>
    </view>

    <button
      wx:if="{{asrFailed}}"
      class="retry-button"
      disabled="{{isTranscribing}}"
      bindtap="retryTranscription"
    >
      再试一次识别
    </button>

    <button
      class="submit-button {{canSubmit ? 'ready' : ''}}"
      disabled="{{!canSubmit || isSubmitting}}"
      bindtap="submitContinuous"
    >
      {{isSubmitting ? '正在提交…' : '提交这次分享'}}
    </button>
  </block>
</view>
