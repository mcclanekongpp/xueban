<view class="page">
  <view wx:if="{{loading}}" class="state-card">
    <view class="state-title">正在准备下一项</view>
    <view class="state-desc">请稍候</view>
  </view>

  <view wx:elif="{{collectionCompleted}}" class="completion-card">
    <view class="completion-title">谢谢你，今天的分享完成啦</view>
    <view class="completion-text">你说过的内容已经保存。现在可以回到学生采集首页。</view>
    <button class="home-button" bindtap="backHome">返回首页</button>
  </view>

  <block wx:else>
    <view class="header">
      <view class="title">首次采集</view>
      <view class="subtitle">按照自己的真实经历和想法回答即可，没有标准答案</view>
    </view>

    <view wx:if="{{currentTask}}" class="task-card">
      <view class="task-progress">第 {{currentTask.task_order}} 项，共 17 项</view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{taskProgressPercent}}%;"></view>
      </view>
      <view class="task-title">{{currentTask.title}}</view>
      <view class="task-prompt">{{currentTask.prompt_text}}</view>
    </view>

    <view class="answer-card" wx:if="{{lastTranscript}}">
      <view class="answer-label">刚才说的是</view>
      <view class="answer-text">{{lastTranscript}}</view>
    </view>

    <view class="voice-area">
      <view
        class="voice-button {{isRecording ? 'recording' : ''}}"
        bindtouchstart="startRecording"
        bindtouchend="stopRecording"
        bindtouchcancel="stopRecording"
      >
        <view class="voice-icon">🎙️</view>
        <view class="voice-text">{{isRecording ? '正在听你说' : '按住说话'}}</view>
      </view>
      <view class="voice-tip">
        {{isRecording ? '松开结束录音' : isSubmitting ? '正在分析并提交' : isUploading ? '正在保存录音' : isTranscribing ? '正在识别语音' : '单次最多59秒，达到上限会自动停止并保存'}}
      </view>
    </view>

    <view wx:if="{{asrFailed && currentVoiceId}}" class="asr-retry-card">
      <view class="asr-retry-text">{{asrRetakeRequired ? '刚才的原始录音已经安全保留，但这段录音无法形成有效文字。请检查麦克风并重新录制，单次最多59秒。' : '刚才的录音已经保存，文字暂未识别成功。请重新识别，成功后再确认提交。'}}</view>
      <button
        wx:if="{{asrRetakeRequired}}"
        class="retry-button"
        bindtap="retakeRecording"
      >
        重新录制
      </button>
      <button
        wx:else
        class="retry-button"
        disabled="{{isTranscribing}}"
        bindtap="retryTranscription"
      >
        {{isTranscribing ? '正在重新识别…' : '重新识别'}}
      </button>
    </view>

    <button
      class="submit-button {{canSubmit ? 'ready' : ''}}"
      disabled="{{!canSubmit || isSubmitting}}"
      bindtap="submitTask"
    >
      {{isSubmitting ? '正在提交…' : '提交并进入下一项'}}
    </button>
  </block>
</view>
