page { background: #f5f7fa; color: #1f2937; }
.page { max-width: 760rpx; margin: 0 auto; padding: 40rpx 32rpx 72rpx; box-sizing: border-box; }
.header { margin-bottom: 28rpx; }
.title { font-size: 44rpx; font-weight: 700; }
.subtitle { margin-top: 12rpx; color: #6b7280; font-size: 28rpx; line-height: 1.6; }
.bind-card, .student-card, .state-card { background: #fff; border-radius: 24rpx; padding: 28rpx; box-shadow: 0 10rpx 30rpx rgba(31, 41, 55, 0.06); }
.field-label { font-size: 26rpx; font-weight: 600; margin-bottom: 14rpx; }
.bind-input { height: 88rpx; padding: 0 22rpx; border-radius: 16rpx; background: #f3f6fa; font-size: 30rpx; }
.primary-button { margin-top: 22rpx; border-radius: 16rpx; background: #2f7dd1; }
.bind-note { margin-top: 18rpx; color: #8a94a3; font-size: 24rpx; line-height: 1.6; }
.section-title { margin: 38rpx 0 18rpx; font-size: 32rpx; font-weight: 700; }
.state-card { color: #7b8491; text-align: center; }
.student-card { margin-bottom: 22rpx; }
.student-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.student-code { color: #334155; font-size: 29rpx; font-weight: 700; letter-spacing: 1rpx; word-break: break-all; }
.progress-badge { flex: none; padding: 8rpx 16rpx; border-radius: 999rpx; color: #2468ae; background: #e9f3ff; font-size: 24rpx; }
.actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 24rpx; }
.action { margin: 0; padding: 0 20rpx; height: 68rpx; line-height: 68rpx; border-radius: 14rpx; color: #31516f; background: #f2f5f8; font-size: 25rpx; }
.action::after { border: none; }
.action.primary { color: #fff; background: #2f7dd1; }
