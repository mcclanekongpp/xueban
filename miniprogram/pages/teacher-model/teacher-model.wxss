page {
    min-height: 100%;
    background: #f5f7fa;
  }
  
  .page {
    min-height: 100vh;
    padding: 28rpx 28rpx 60rpx;
    box-sizing: border-box;
  }
  
  
  /* ==================================================
     通用状态卡片
     ================================================== */
  
  .state-card {
    margin-top: 160rpx;
    padding: 48rpx 36rpx;
    background: #ffffff;
    border-radius: 24rpx;
    text-align: center;
  }
  
  .state-title {
    font-size: 32rpx;
    line-height: 1.5;
    font-weight: 600;
    color: #25282e;
  }
  
  .state-desc {
    margin-top: 16rpx;
    font-size: 25rpx;
    line-height: 1.7;
    color: #7d838d;
  }
  
  .refresh-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  
    margin-top: 32rpx;
    padding: 18rpx 34rpx;
  
    background: #eef4ff;
    border-radius: 999rpx;
  
    font-size: 26rpx;
    color: #2f7de1;
  }
  
  
  /* ==================================================
     顶部模型说明
     ================================================== */
  
  .model-header {
    padding: 22rpx 6rpx 30rpx;
  }
  
  .model-header-title {
    font-size: 40rpx;
    line-height: 1.4;
    font-weight: 600;
    color: #1f2329;
  }
  
  .model-header-desc {
    margin-top: 14rpx;
  
    font-size: 26rpx;
    line-height: 1.7;
    color: #6f7680;
  }
  
  .model-meta {
    display: flex;
    align-items: center;
  
    margin-top: 18rpx;
  
    font-size: 23rpx;
    line-height: 1.4;
    color: #8b919b;
  }
  
  .meta-dot {
    margin: 0 12rpx;
  }
  
  
  /* ==================================================
     通用区块卡片
     ================================================== */
  
  .section-card {
    padding: 30rpx;
    background: #ffffff;
    border-radius: 24rpx;
    box-sizing: border-box;
  }
  
  .section-heading {
    font-size: 30rpx;
    line-height: 1.4;
    font-weight: 600;
    color: #25282e;
  }
  
  
  /* ==================================================
     T0 基本背景
     ================================================== */
  
  .background-section {
    margin-bottom: 34rpx;
  }
  
  .background-grid {
    margin-top: 22rpx;
  }
  
  .background-item {
    display: flex;
    align-items: flex-start;
  
    padding: 17rpx 0;
  
    border-bottom: 1rpx solid #f0f1f3;
  }
  
  .background-item:last-child {
    border-bottom: none;
  }
  
  .background-label {
    width: 180rpx;
    flex-shrink: 0;
  
    font-size: 25rpx;
    line-height: 1.6;
    color: #858b95;
  }
  
  .background-value {
    flex: 1;
  
    font-size: 26rpx;
    line-height: 1.6;
    color: #333840;
  }
  
  
  /* ==================================================
     一级维度
     ================================================== */
  
  .dimension-section {
    margin-bottom: 36rpx;
  }
  
  .dimension-title-row {
    display: flex;
    align-items: center;
  
    margin: 0 4rpx 18rpx;
  }
  
  .dimension-code {
    display: flex;
    align-items: center;
    justify-content: center;
  
    min-width: 62rpx;
    height: 42rpx;
    padding: 0 12rpx;
  
    background: #2f7de1;
    border-radius: 12rpx;
  
    font-size: 23rpx;
    font-weight: 600;
    color: #ffffff;
  
    box-sizing: border-box;
  }
  
  .dimension-name {
    margin-left: 14rpx;
  
    font-size: 31rpx;
    line-height: 1.4;
    font-weight: 600;
    color: #2a3038;
  }
  
  
  /* ==================================================
     二级变量卡片
     ================================================== */
  
  .variable-card {
    margin-bottom: 18rpx;
    padding: 28rpx;
  
    background: #ffffff;
    border-radius: 22rpx;
  
    box-sizing: border-box;
  }
  
  .variable-card:last-child {
    margin-bottom: 0;
  }
  
  .variable-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  
  .variable-title-wrap {
    display: flex;
    align-items: center;
  
    flex: 1;
    min-width: 0;
    padding-right: 18rpx;
  }
  
  .variable-code {
    flex-shrink: 0;
  
    padding: 6rpx 10rpx;
  
    background: #f1f4f8;
    border-radius: 9rpx;
  
    font-size: 21rpx;
    line-height: 1.3;
    font-weight: 500;
    color: #5b6470;
  }
  
  .variable-name {
    margin-left: 12rpx;
  
    font-size: 28rpx;
    line-height: 1.45;
    font-weight: 600;
    color: #272c33;
  }
  
  
  /* ==================================================
     置信状态
     ================================================== */
  
  .confidence-tag {
    flex-shrink: 0;
  
    padding: 7rpx 13rpx;
  
    border-radius: 999rpx;
  
    font-size: 21rpx;
    line-height: 1.3;
    white-space: nowrap;
  }
  
  .confidence-insufficient {
    background: #f2f3f5;
    color: #8b919b;
  }
  
  .confidence-low {
    background: #eef5ff;
    color: #3777c8;
  }
  
  .confidence-medium {
    background: #eef8f1;
    color: #4e8060;
  }
  
  .confidence-high {
    background: #edf7ef;
    color: #39784c;
  }
  
  
  /* ==================================================
     内容区
     ================================================== */
  
  .content-block {
    margin-top: 24rpx;
  }
  
  .content-label {
    margin-bottom: 10rpx;
  
    font-size: 23rpx;
    line-height: 1.4;
    font-weight: 500;
    color: #8a9099;
  }
  
  .current-state {
    font-size: 26rpx;
    line-height: 1.8;
    color: #343941;
  }
  
  
  /* ==================================================
     证据依据
     ================================================== */
  
  .evidence-item {
    display: flex;
    align-items: flex-start;
  
    margin-bottom: 10rpx;
  }
  
  .evidence-item:last-child {
    margin-bottom: 0;
  }
  
  .evidence-dot {
    width: 24rpx;
    flex-shrink: 0;
  
    font-size: 28rpx;
    line-height: 1.55;
    color: #6d89aa;
  }
  
  .evidence-text {
    flex: 1;
  
    font-size: 24rpx;
    line-height: 1.75;
    color: #59616c;
  }
  
  
  /* ==================================================
     情境 / 当前限制
     ================================================== */
  
  .simple-list-item {
    position: relative;
  
    padding-left: 24rpx;
    margin-bottom: 10rpx;
  
    font-size: 24rpx;
    line-height: 1.7;
    color: #606873;
  }
  
  .simple-list-item:last-child {
    margin-bottom: 0;
  }
  
  .simple-list-item::before {
    content: '·';
  
    position: absolute;
    left: 2rpx;
    top: 0;
  
    color: #8e949d;
  }
  
  .uncertainty-block {
    padding-top: 20rpx;
    border-top: 1rpx solid #f0f1f3;
  }
  
  
  /* ==================================================
     模型说明
     ================================================== */
  
  .caution-section {
    margin-top: 12rpx;
  }
  
  .caution-item {
    margin-top: 14rpx;
  
    font-size: 23rpx;
    line-height: 1.75;
    color: #747b85;
  }
  
  
  /* ==================================================
     底部刷新
     ================================================== */
  
  .bottom-refresh {
    display: flex;
    align-items: center;
    justify-content: center;
  
    margin-top: 28rpx;
    padding: 24rpx;
  
    font-size: 25rpx;
    line-height: 1.4;
    color: #6d7680;
  }