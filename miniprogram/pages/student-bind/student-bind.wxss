page {
  min-height: 100%;
  background: #f5f7fa;
}

.page {
  min-height: 100vh;
  padding: 72rpx 36rpx 60rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #1f2329;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #6b7280;
}

.form-card {
  padding: 8rpx 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf0f3;
}

.field-last {
  border-bottom: 0;
}

.label {
  margin-bottom: 14rpx;
  font-size: 27rpx;
  line-height: 1.4;
  color: #353a42;
}

.input {
  height: 72rpx;
  padding: 0 22rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
  font-size: 29rpx;
  color: #1f2329;
  box-sizing: border-box;
}

.submit-button {
  margin-top: 36rpx;
  background: #2f7de1;
  border-radius: 18rpx;
  font-size: 30rpx;
}

.note {
  margin-top: 28rpx;
  padding: 0 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a9099;
  text-align: center;
}
