/* pages/role-select/role-select.wxss */

page {
    background: #f7f8fa;
  }
  
  .page {
    min-height: 100vh;
    padding: 96rpx 40rpx 60rpx;
    box-sizing: border-box;
  }
  
  .header {
    margin-bottom: 56rpx;
  }
  
  .title {
    display: block;
    font-size: 48rpx;
    font-weight: 600;
    color: #1f2329;
    line-height: 1.4;
  }
  
  .subtitle {
    display: block;
    margin-top: 14rpx;
    font-size: 30rpx;
    color: #646a73;
    line-height: 1.5;
  }
  
  .role-list {
    display: flex;
    flex-direction: column;
    gap: 28rpx;
  }
  
  .role-card {
    display: flex;
    align-items: center;
    min-height: 168rpx;
    padding: 30rpx 28rpx;
    background: #ffffff;
    border-radius: 24rpx;
    box-sizing: border-box;
    box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
  }
  
  .role-card:active {
    transform: scale(0.99);
    opacity: 0.92;
  }
  
  .role-icon {
    width: 84rpx;
    height: 84rpx;
    margin-right: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 52rpx;
  }
  
  .role-content {
    flex: 1;
    min-width: 0;
  }
  
  .role-title {
    display: block;
    font-size: 34rpx;
    font-weight: 600;
    color: #1f2329;
    line-height: 1.4;
  }
  
  .role-desc {
    display: block;
    margin-top: 12rpx;
    font-size: 26rpx;
    color: #8f959e;
    line-height: 1.6;
  }
  
  .arrow {
    margin-left: 16rpx;
    font-size: 52rpx;
    color: #b7bbc2;
    line-height: 1;
  }
  
  .footer {
    margin-top: 56rpx;
    padding: 0 12rpx;
    text-align: center;
  }
  
  .footer-text {
    font-size: 24rpx;
    color: #a3a8b0;
    line-height: 1.6;
  }