/* pages/voice-chat/voice-chat.wxss */

page {
  background: #f6f7f9;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 56rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}


/* =========================
   顶部
   ========================= */

.header {
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.4;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #7f858d;
  line-height: 1.6;
}


/* =========================
   预设采集任务卡片
   ========================= */

.task-card {
  padding: 32rpx 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 35, 41, 0.06);
}

.task-progress {
  margin-bottom: 18rpx;
}

.task-progress-text {
  font-size: 23rpx;
  color: #7c8796;
  line-height: 1.4;
}

.task-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #25292f;
  line-height: 1.5;
}

.task-prompt {
  display: block;
  margin-top: 20rpx;
  font-size: 29rpx;
  color: #3f444b;
  line-height: 1.8;
}


/* =========================
   对话区域
   ========================= */

.conversation-area {
  flex: 1;
  padding-top: 28rpx;
  padding-bottom: 36rpx;
}

.message {
  max-width: 86%;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.assistant-message {
  background: #ffffff;
  border-top-left-radius: 8rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.05);
}

.teacher-message {
  margin-top: 24rpx;
  margin-left: auto;
  background: #eaf3ff;
  border-top-right-radius: 8rpx;
}

.message-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #6f7f95;
  line-height: 1.4;
}

.message-text {
  font-size: 28rpx;
  color: #34383e;
  line-height: 1.7;
}

.status-message {
  margin-top: 24rpx;
  text-align: center;
}

.status-text {
  font-size: 24rpx;
  color: #9a9fa7;
  line-height: 1.5;
}


/* =========================
   录音区域
   ========================= */

.voice-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 24rpx;
}

.voice-button {
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(31, 35, 41, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.voice-button:active {
  transform: scale(0.97);
}

.voice-icon {
  font-size: 62rpx;
  line-height: 1;
}

.voice-text {
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 500;
  color: #25292f;
}

.voice-tip {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: #969ba3;
  line-height: 1.5;
}


/* =========================
   完成本题按钮
   ========================= */

.complete-button {
  width: 100%;
  height: 92rpx;
  margin-top: 34rpx;
  border-radius: 18rpx;

  background: #e3e6ea;
  color: #9ba0a7;

  font-size: 29rpx;
  font-weight: 500;

  display: flex;
  align-items: center;
  justify-content: center;

  border: none;
}

.complete-button::after {
  border: none;
}

.complete-button-ready {
  background: #2475d0;
  color: #ffffff;
}

.answer-tip {
  display: block;
  width: 100%;
  margin-top: 18rpx;

  text-align: center;

  font-size: 23rpx;
  color: #9298a0;
  line-height: 1.6;
}


/* =========================
   首次采集完成
   ========================= */

.completion-card {
  margin-top: 28rpx;
  padding: 42rpx 34rpx;

  background: #ffffff;
  border-radius: 24rpx;

  box-shadow: 0 8rpx 30rpx rgba(31, 35, 41, 0.06);
}

.completion-title {
  display: block;

  font-size: 34rpx;
  font-weight: 600;
  color: #25292f;

  line-height: 1.5;
}

.completion-text {
  display: block;
  margin-top: 20rpx;

  font-size: 27rpx;
  color: #626870;

  line-height: 1.8;
}