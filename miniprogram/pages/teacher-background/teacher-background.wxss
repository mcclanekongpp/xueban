page {
    background: #f5f7fa;
    min-height: 100%;
  }
  
  .page {
    min-height: 100vh;
    padding: 24rpx;
    box-sizing: border-box;
  }
  
  .loading-wrap {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .loading-text {
    font-size: 28rpx;
    color: #8a8f99;
  }
  
  .form-wrap {
    width: 100%;
    box-sizing: border-box;
  }
  
  .intro-card {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-sizing: border-box;
  }
  
  .intro-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #1f2329;
    line-height: 1.4;
  }
  
  .intro-desc {
    margin-top: 16rpx;
    font-size: 26rpx;
    color: #6b7280;
    line-height: 1.7;
  }
  
  .section-title {
    margin: 36rpx 8rpx 18rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #30343b;
  }
  
  .form-item {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 28rpx;
    margin-bottom: 18rpx;
    box-sizing: border-box;
  }
  
  .form-label {
    font-size: 28rpx;
    font-weight: 500;
    color: #25282e;
    line-height: 1.5;
  }
  
  .form-input {
    width: 100%;
    height: 76rpx;
    margin-top: 16rpx;
    padding: 0 20rpx;
    background: #f7f8fa;
    border-radius: 14rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    color: #1f2329;
  }
  
  .picker-value {
    min-height: 76rpx;
    margin-top: 16rpx;
    padding: 0 20rpx;
    display: flex;
    align-items: center;
    background: #f7f8fa;
    border-radius: 14rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    color: #1f2329;
  }
  
  .placeholder-text {
    color: #a8adb7;
  }
  
  .form-tip {
    margin-top: 12rpx;
    font-size: 23rpx;
    color: #969ba5;
    line-height: 1.5;
  }
  
  .form-textarea {
    width: 100%;
    min-height: 180rpx;
    margin-top: 16rpx;
    padding: 20rpx;
    background: #f7f8fa;
    border-radius: 14rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    color: #1f2329;
    line-height: 1.6;
  }
  
  .training-textarea {
    min-height: 240rpx;
  }
  
  .switch-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .switch-text {
    flex: 1;
    padding-right: 24rpx;
  }
  
  .save-button {
    margin-top: 36rpx;
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 46rpx;
    font-size: 30rpx;
    font-weight: 500;
  }
  
  .save-button::after {
    border: none;
  }
  
  .bottom-note {
    padding: 28rpx 24rpx 48rpx;
    font-size: 23rpx;
    color: #969ba5;
    line-height: 1.7;
    text-align: center;
  }