page {
    min-height: 100%;
    background: #f5f7fa;
  }

  .page {
    min-height: 100vh;
    padding: 28rpx 28rpx 60rpx;
    box-sizing: border-box;
    max-width: 900rpx;
    margin: 0 auto;
  }


  /* ==================================================
     顶部
     ================================================== */
  
  .header {
    padding: 18rpx 4rpx 28rpx;
  }
  
  .header-title {
    font-size: 40rpx;
    line-height: 1.35;
    font-weight: 600;
    color: #1f2329;
  }
  
  .header-desc {
    margin-top: 12rpx;
    font-size: 27rpx;
    line-height: 1.65;
    color: #6b7280;
  }
  
  
  /* ==================================================
     基本信息
     ================================================== */
  
  .background-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
  
    padding: 30rpx 30rpx;
    margin-bottom: 24rpx;
  
    background: #ffffff;
    border-radius: 24rpx;
  
    box-sizing: border-box;
  }
  
  .background-content {
    flex: 1;
    min-width: 0;
    padding-right: 24rpx;
  }
  
  .background-title {
    font-size: 31rpx;
    line-height: 1.4;
    font-weight: 600;
    color: #25282e;
  }
  
  .background-desc {
    margin-top: 10rpx;
    font-size: 25rpx;
    line-height: 1.55;
    color: #7a808a;
  }
  
  .background-arrow {
    flex-shrink: 0;
    font-size: 42rpx;
    line-height: 1;
    color: #a0a6b0;
  }
  
  
  /* ==================================================
     首次建模采集
     ================================================== */
  
  .initial-card {
    width: 100%;
    padding: 30rpx;
  
    background: #edf5ff;
    border-radius: 24rpx;
  
    box-sizing: border-box;
    overflow: hidden;
  }

  .initial-card-completed {
    padding: 22rpx 26rpx;
  }

  .initial-card-completed .initial-top-row {
    margin-bottom: 12rpx;
  }

  .initial-card-completed .initial-card-title {
    font-size: 30rpx;
  }

  .initial-card-completed .initial-card-desc {
    margin-top: 8rpx;
    font-size: 24rpx;
    line-height: 1.55;
  }
  
  .initial-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  
    width: 100%;
    margin-bottom: 20rpx;
  }
  
  .initial-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  
    padding: 8rpx 16rpx;
  
    border-radius: 999rpx;
    background: #2f7de1;
  
    font-size: 22rpx;
    line-height: 1.2;
    color: #ffffff;
  
    flex-shrink: 0;
  }
  
  .initial-progress {
    margin-left: 20rpx;
  
    font-size: 25rpx;
    line-height: 1.4;
    font-weight: 500;
    color: #527092;
  
    white-space: nowrap;
    flex-shrink: 0;
  }
  
  .initial-card-title {
    font-size: 34rpx;
    line-height: 1.45;
    font-weight: 600;
    color: #202c3b;
  }
  
  .initial-card-desc {
    margin-top: 14rpx;
  
    font-size: 26rpx;
    line-height: 1.7;
    color: #52657b;
  }
  
  .initial-next {
    margin-top: 20rpx;
    padding: 18rpx 20rpx;
  
    background: rgba(255, 255, 255, 0.7);
    border-radius: 16rpx;
  
    font-size: 25rpx;
    line-height: 1.5;
    color: #365f8f;
  }
  
  .initial-action {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  
    margin-top: 24rpx;
  
    font-size: 27rpx;
    line-height: 1.4;
    font-weight: 500;
    color: #2f7de1;
  }
  
  .initial-arrow {
    margin-left: 10rpx;
    font-size: 36rpx;
    line-height: 1;
  }
  
  
  /* ==================================================
     分区标题
     ================================================== */
  
  .section-title {
    margin: 38rpx 6rpx 18rpx;
  
    font-size: 29rpx;
    line-height: 1.4;
    font-weight: 600;
    color: #4b515b;
  }

  .section-desc {
    margin: -8rpx 6rpx 18rpx;
    font-size: 24rpx;
    line-height: 1.65;
    color: #858b95;
  }


  .card-arrow {
    margin-left: 20rpx;
  
    font-size: 42rpx;
    line-height: 1;
    color: #a6abb4;
  
    flex-shrink: 0;
  }
  
  
  /* ==================================================
     常用记录
     ================================================== */
  
  .record-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  
    margin-top: 20rpx;
  }
  
  .record-card {
    width: calc(50% - 9rpx);
    min-height: 210rpx;
  
    padding: 26rpx;
    margin-bottom: 18rpx;
  
    background: #ffffff;
    border-radius: 22rpx;
  
    box-sizing: border-box;
  }

  .record-icon {
    font-size: 34rpx;
    line-height: 1.2;
    color: #44515f;
  }
  
  .record-title {
    margin-top: 20rpx;
  
    font-size: 28rpx;
    line-height: 1.4;
    font-weight: 600;
    color: #25282e;
  }
  
  .record-desc {
    margin-top: 10rpx;
  
    font-size: 23rpx;
    line-height: 1.55;
    color: #858b95;
  }

  .guidance-state,
  .guidance-card {
    margin-bottom: 16rpx;
    padding: 24rpx 26rpx;
    border-radius: 22rpx;
    background: #ffffff;
    box-sizing: border-box;
  }

  .guidance-state {
    font-size: 24rpx;
    line-height: 1.6;
    color: #858b95;
  }

  .guidance-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .guidance-variable {
    flex: 1;
    min-width: 0;
    font-size: 27rpx;
    line-height: 1.45;
    font-weight: 600;
    color: #25282e;
  }

  .guidance-action {
    margin-left: 20rpx;
    flex-shrink: 0;
    font-size: 24rpx;
    color: #2f7de1;
  }

  .guidance-reason {
    margin-top: 10rpx;
    font-size: 23rpx;
    line-height: 1.6;
    color: #7d838d;
  }

  .guidance-prompt {
    margin-top: 14rpx;
    padding: 16rpx 18rpx;
    border-radius: 16rpx;
    background: #f5f8fc;
    font-size: 25rpx;
    line-height: 1.65;
    color: #36516f;
  }
  
  
  /* ==================================================
     当前模型
     ================================================== */
  
  .model-section-title {
    margin-top: 30rpx;
  }
  
  .model-card {
    display: flex;
    align-items: center;
  
    width: 100%;
    padding: 30rpx;
  
    background: #ffffff;
    border-radius: 24rpx;
  
    box-sizing: border-box;
  }

  .student-entry-card {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 30rpx;
    background: #ffffff;
    border-radius: 24rpx;
    box-sizing: border-box;
  }

  .student-entry-content {
    flex: 1;
    min-width: 0;
    padding-right: 20rpx;
  }

  .student-entry-title {
    font-size: 30rpx;
    line-height: 1.4;
    font-weight: 600;
    color: #25282e;
  }

  .student-entry-desc {
    margin-top: 10rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #7d838d;
  }
  
  .model-content {
    flex: 1;
    min-width: 0;
    padding-right: 20rpx;
  }
  
  .model-title {
    font-size: 30rpx;
    line-height: 1.4;
    font-weight: 600;
    color: #25282e;
  }
  
  .model-desc {
    margin-top: 10rpx;
  
    font-size: 24rpx;
    line-height: 1.6;
    color: #7d838d;
  }
  
  
  /* ==================================================
     底部说明
     ================================================== */
  
  .page-note {
    padding: 30rpx 24rpx 10rpx;
  
    font-size: 23rpx;
    line-height: 1.7;
    color: #999fa8;
    text-align: center;
  }
